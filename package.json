{
  "name": "circuit-json-to-step",
  "main": "dist/index.js",
  "version": "0.0.62",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/circuit-json-to-step.git"
  },
  "type": "module",
  "scripts": {
    "pull-reference": "git clone https://github.com/tscircuit/circuit-json.git && find circuit-json/tests -name '*.test.ts' -exec bash -c 'mv \"$0\" \"${0%.test.ts}.ts\"' {} \\; && git clone https://github.com/tscircuit/stepts.git && find stepts/tests -name '*.test.ts' -exec bash -c 'mv \"$0\" \"${0%.test.ts}.ts\"' {} \\;",
    "test": "bun test",
    "test:update-snapshots": "BUN_UPDATE_SNAPSHOTS=1 bun test",
    "build": "tsup-node ./lib/index.ts --format esm --dts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "bun site/index.html",
    "build:site": "bun build site/index.html --outdir=site-export",
    "prepare": "bun install --frozen-lockfile --ignore-scripts && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@resvg/resvg-js": "^2.6.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tscircuit/capacity-autorouter": "0.0.988",
    "@tscircuit/checks": "0.0.256",
    "@tscircuit/circuit-json-util": "^0.0.122",
    "@tscircuit/core": "0.0.2172",
    "@tscircuit/footprinter": "0.0.440",
    "@tscircuit/math-utils": "0.0.36",
    "@tscircuit/props": "0.0.704",
    "@types/bun": "latest",
    "@types/react": "19.2.2",
    "circuit-json": "^0.0.528",
    "circuit-to-svg": "^0.0.356",
    "looks-same": "^10.0.1",
    "occt-import-js": "^0.0.23",
    "poppygl": "^0.0.24",
    "react": "19.3.1",
    "schematic-symbols": "^0.0.248",
    "tsup": "^8.5.0",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@tscircuit/circuit-json-util": "*",
    "typescript": "^5",
    "circuit-to-svg": "*"
  },
  "dependencies": {
    "circuit-json-to-connectivity-map": "^0.0.22",
    "circuit-json-to-gltf": "^0.0.106",
    "color": "^5.0.3",
    "jscad-to-step": "^0.0.11",
    "polygon-clipping": "^0.15.7",
    "stepts": "^0.0.7"
  }
}
